{
  "id": "uc3-widow-enrolment",
  "name": "UC3 Widow Enrolment (Farajaland)",
  "description": "DCI demo (Friday 2026-05-15) — field agent intake of disabled-widow applications, pushed to OpenSPP via assign_program ChangeRequest workflow.",
  "version": "1.0.0",
  "entityForms": [
    {
      "id": "household",
      "name": "household",
      "title": "Household",
      "entityType": "group",
      "nameField": "name",
      "displayTemplate": "{name}",
      "formio": {
        "display": "form",
        "components": [
          {
            "key": "name",
            "type": "textfield",
            "input": true,
            "label": "Household Name",
            "validate": { "required": true }
          },
          {
            "key": "area",
            "type": "select",
            "input": true,
            "label": "Area",
            "validate": { "required": true },
            "data": {
              "values": [
                { "label": "Farajaland — North", "value": "farajaland-north" },
                { "label": "Farajaland — South", "value": "farajaland-south" },
                { "label": "Farajaland — Central", "value": "farajaland-central" }
              ]
            }
          },
          {
            "key": "address",
            "type": "textarea",
            "input": true,
            "label": "Address",
            "rows": 3
          },
          {
            "key": "phone",
            "type": "phoneNumber",
            "input": true,
            "label": "Phone Number"
          },
          {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Save Household",
            "action": "submit",
            "theme": "primary"
          }
        ]
      }
    },
    {
      "id": "widow",
      "name": "widow",
      "title": "Widow (Applicant)",
      "entityType": "individual",
      "nameField": "name",
      "displayTemplate": "{name}",
      "dependsOn": "household",
      "description": "Primary applicant identity. Disability + PMT inputs are owned by OpenSPP downstream and transparent to DataCollect — do not duplicate them here.",
      "formio": {
        "display": "form",
        "components": [
          {
            "key": "first_name",
            "type": "textfield",
            "input": true,
            "label": "First Name",
            "validate": { "required": true }
          },
          {
            "key": "last_name",
            "type": "textfield",
            "input": true,
            "label": "Last Name",
            "validate": { "required": true }
          },
          {
            "key": "name",
            "type": "hidden",
            "calculateValue": "value = (data.first_name||'') + ' ' + (data.last_name||'')"
          },
          {
            "key": "date_of_birth",
            "type": "datetime",
            "input": true,
            "label": "Date of Birth",
            "format": "yyyy-MM-dd",
            "enableTime": false,
            "enableDate": true,
            "validate": { "required": true }
          },
          {
            "key": "gender",
            "type": "select",
            "input": true,
            "label": "Gender",
            "defaultValue": "female",
            "data": {
              "values": [
                { "label": "Female", "value": "female" },
                { "label": "Male", "value": "male" },
                { "label": "Other", "value": "other" }
              ]
            }
          },
          {
            "key": "national_id",
            "type": "textfield",
            "input": true,
            "label": "National ID",
            "description": "Optional. If a Claim-169 VC is scanned, this is auto-filled."
          },
          {
            "key": "widow_status",
            "type": "select",
            "input": true,
            "label": "Widow Status",
            "validate": { "required": true },
            "data": {
              "values": [
                { "label": "Self-declared", "value": "self_declared" },
                { "label": "Verified by spouse death record", "value": "verified" }
              ]
            }
          },
          {
            "key": "claim169_panel",
            "type": "panel",
            "title": "Identity Verification (optional)",
            "collapsible": true,
            "collapsed": true,
            "description": "Scan the applicant's MOSIP wallet QR to verify identity. Skippable for the demo — the Claim-169 component wiring is post-demo work (UC3 Phase 4).",
            "components": [
              {
                "key": "claim169_verified",
                "type": "select",
                "input": true,
                "label": "Verification result",
                "data": {
                  "values": [
                    { "label": "Verified via MOSIP VC", "value": "verified" },
                    { "label": "Not scanned (manual entry)", "value": "not_scanned" },
                    { "label": "Scan failed", "value": "failed" }
                  ]
                },
                "defaultValue": "not_scanned"
              },
              {
                "key": "claim169_issuer_did",
                "type": "textfield",
                "input": true,
                "label": "Issuer DID (auto-filled by scanner)",
                "disabled": true
              }
            ]
          },
          {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Save Application",
            "action": "submit",
            "theme": "primary"
          }
        ]
      }
    },
    {
      "id": "dependent",
      "name": "dependent",
      "title": "Dependent",
      "entityType": "individual",
      "nameField": "name",
      "displayTemplate": "{name}",
      "dependsOn": "household",
      "description": "Other household members. Identity only — school enrolment, disability, PMT-relevant fields are derived/queried by OpenSPP downstream.",
      "formio": {
        "display": "form",
        "components": [
          {
            "key": "first_name",
            "type": "textfield",
            "input": true,
            "label": "First Name",
            "validate": { "required": true }
          },
          {
            "key": "last_name",
            "type": "textfield",
            "input": true,
            "label": "Last Name",
            "validate": { "required": true }
          },
          {
            "key": "name",
            "type": "hidden",
            "calculateValue": "value = (data.first_name||'') + ' ' + (data.last_name||'')"
          },
          {
            "key": "date_of_birth",
            "type": "datetime",
            "input": true,
            "label": "Date of Birth",
            "format": "yyyy-MM-dd",
            "enableTime": false,
            "enableDate": true
          },
          {
            "key": "relationship",
            "type": "select",
            "input": true,
            "label": "Relationship to Widow",
            "validate": { "required": true },
            "data": {
              "values": [
                { "label": "Child", "value": "child" },
                { "label": "Parent", "value": "parent" },
                { "label": "Sibling", "value": "sibling" },
                { "label": "Other relative", "value": "other_relative" }
              ]
            }
          },
          {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Save Dependent",
            "action": "submit",
            "theme": "primary"
          }
        ]
      }
    }
  ],
  "entityData": [
    {
      "name": "household",
      "data": [
        {
          "id": "hh-uc3-demo-001",
          "name": "Adeyemi Household",
          "area": "farajaland-north",
          "address": "Plot 4, Maseno Lane, North Farajaland",
          "phone": "+999-555-0001"
        }
      ]
    },
    {
      "name": "widow",
      "data": [
        {
          "id": "ind-uc3-widow-001",
          "name": "Funke Adeyemi",
          "first_name": "Funke",
          "last_name": "Adeyemi",
          "date_of_birth": "1982-06-14",
          "gender": "female",
          "national_id": "FJ-1982-0001",
          "widow_status": "self_declared",
          "claim169_verified": "not_scanned",
          "parentId": "hh-uc3-demo-001"
        }
      ]
    },
    {
      "name": "dependent",
      "data": [
        {
          "id": "ind-uc3-dep-001",
          "name": "Sade Adeyemi",
          "first_name": "Sade",
          "last_name": "Adeyemi",
          "date_of_birth": "2012-02-09",
          "relationship": "child",
          "parentId": "hh-uc3-demo-001"
        },
        {
          "id": "ind-uc3-dep-002",
          "name": "Tunde Adeyemi",
          "first_name": "Tunde",
          "last_name": "Adeyemi",
          "date_of_birth": "2015-11-23",
          "relationship": "child",
          "parentId": "hh-uc3-demo-001"
        }
      ]
    }
  ],
  "externalSync": {
    "type": "openspp-v2-adapter",
    "url": "${OPENSPP_URL}",
    "adapterConfig": {
      "clientId": "${OPENSPP_CLIENT_ID}",
      "clientSecret": "${OPENSPP_CLIENT_SECRET}",
      "submitVia": "direct",
      "identifierType": "system_id",
      "groupIdentifierType": "system_id",
      "identifierNamespace": "urn:openspp:vocab:id-type#",
      "batchSize": 25,
      "batchDelayMs": 250,
      "maxRetries": 2,
      "_comment": "submitVia=direct for household + members (DataCollect = source of truth). Program enrolment goes via assign_program CR regardless because it's approval-gated on OpenSPP."
    }
  },
  "programs": [
    {
      "id": "${OPENSPP_PROGRAM_ID}",
      "name": "Widow Disability Support",
      "code": "widow-disability-support"
    }
  ]
}
