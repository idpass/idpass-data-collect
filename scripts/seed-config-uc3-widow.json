{
  "id": "uc3-widow-enrolment",
  "name": "UC3 Widow Enrollment",
  "description": "DCI demo (Friday 2026-05-15) — field agent intake of disabled-widow applications, pushed to OpenSPP via assign_program ChangeRequest workflow.",
  "version": "1.0.0",
  "syncServerUrl": "${DATACOLLECT_SYNC_URL}",
  "entityForms": [
    {
      "id": "household",
      "name": "household",
      "title": "Household",
      "entityType": "group",
      "nameField": "name",
      "displayTemplate": "{name}",
      "formio": {
        "display": "form",
        "components": [
          {
            "key": "name",
            "type": "textfield",
            "input": true,
            "label": "Household Name",
            "validate": { "required": true }
          },
          {
            "key": "area",
            "type": "select",
            "input": true,
            "label": "Area",
            "validate": { "required": true },
            "data": {
              "values": [
                { "label": "North District", "value": "north-district" },
                { "label": "South District", "value": "south-district" },
                { "label": "Central District", "value": "central-district" }
              ]
            }
          },
          {
            "key": "address",
            "type": "textarea",
            "input": true,
            "label": "Address",
            "rows": 3
          },
          {
            "key": "phone",
            "type": "phoneNumber",
            "input": true,
            "label": "Phone Number"
          },
          {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Save Household",
            "action": "submit",
            "theme": "primary"
          }
        ]
      }
    },
    {
      "id": "widow",
      "name": "widow",
      "title": "Widow (Applicant)",
      "entityType": "individual",
      "nameField": "name",
      "displayTemplate": "{name}",
      "dependsOn": "household",
      "description": "Primary applicant identity. Disability + PMT inputs are owned by OpenSPP downstream and transparent to DataCollect — do not duplicate them here.",
      "formio": {
        "display": "form",
        "components": [
          {
            "key": "first_name",
            "type": "textfield",
            "input": true,
            "label": "First Name",
            "validate": { "required": true }
          },
          {
            "key": "last_name",
            "type": "textfield",
            "input": true,
            "label": "Last Name",
            "validate": { "required": true }
          },
          {
            "key": "name",
            "type": "hidden",
            "calculateValue": "value = (data.first_name||'') + ' ' + (data.last_name||'')"
          },
          {
            "key": "date_of_birth",
            "type": "datetime",
            "input": true,
            "label": "Date of Birth",
            "format": "yyyy-MM-dd",
            "enableTime": false,
            "enableDate": true,
            "validate": { "required": true }
          },
          {
            "key": "gender",
            "type": "select",
            "input": true,
            "label": "Gender",
            "defaultValue": "female",
            "data": {
              "values": [
                { "label": "Female", "value": "female" },
                { "label": "Male", "value": "male" },
                { "label": "Other", "value": "other" }
              ]
            }
          },
          {
            "key": "national_id",
            "type": "textfield",
            "input": true,
            "label": "National ID",
            "description": "Auto-filled when a Claim-169 VC is scanned below."
          },
          {
            "key": "widow_status",
            "type": "select",
            "input": true,
            "label": "Widow Status",
            "validate": { "required": true },
            "data": {
              "values": [
                { "label": "Self-declared", "value": "self_declared" },
                { "label": "Verified by spouse death record", "value": "verified" }
              ]
            }
          },
          {
            "key": "identityVerification",
            "type": "claim169Scanner",
            "label": "Scan MOSIP wallet QR (Claim-169)",
            "input": true,
            "description": "Optional. Verifies the applicant's identity against the trusted MOSIP issuer offline. On success, auto-fills first/last name, date of birth, gender, and national ID.",
            "storeOriginalData": false,
            "trustedIssuers": [
              {
                "issuerId": "did:web:demo-issuer.example.gov",
                "publicKey": {
                  "ed25519": "${UC3_ISSUER_ED25519_PUB_B64}"
                }
              }
            ],
            "fieldMappings": [
              { "claimField": "firstName",   "formField": "first_name",  "overwrite": true },
              { "claimField": "lastName",    "formField": "last_name",   "overwrite": true },
              { "claimField": "dateOfBirth", "formField": "date_of_birth", "overwrite": true },
              { "claimField": "id",          "formField": "national_id", "overwrite": true }
            ]
          },
          {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Save Application",
            "action": "submit",
            "theme": "primary"
          }
        ]
      }
    },
    {
      "id": "dependent",
      "name": "dependent",
      "title": "Dependent",
      "entityType": "individual",
      "nameField": "name",
      "displayTemplate": "{name}",
      "dependsOn": "household",
      "description": "Other household members. Identity only — school enrolment, disability, PMT-relevant fields are derived/queried by OpenSPP downstream.",
      "formio": {
        "display": "form",
        "components": [
          {
            "key": "first_name",
            "type": "textfield",
            "input": true,
            "label": "First Name",
            "validate": { "required": true }
          },
          {
            "key": "last_name",
            "type": "textfield",
            "input": true,
            "label": "Last Name",
            "validate": { "required": true }
          },
          {
            "key": "name",
            "type": "hidden",
            "calculateValue": "value = (data.first_name||'') + ' ' + (data.last_name||'')"
          },
          {
            "key": "date_of_birth",
            "type": "datetime",
            "input": true,
            "label": "Date of Birth",
            "format": "yyyy-MM-dd",
            "enableTime": false,
            "enableDate": true
          },
          {
            "key": "relationship",
            "type": "select",
            "input": true,
            "label": "Relationship to Widow",
            "validate": { "required": true },
            "data": {
              "values": [
                { "label": "Child", "value": "child" },
                { "label": "Parent", "value": "parent" },
                { "label": "Sibling", "value": "sibling" },
                { "label": "Other relative", "value": "other_relative" }
              ]
            }
          },
          {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Save Dependent",
            "action": "submit",
            "theme": "primary"
          }
        ]
      }
    }
  ],
