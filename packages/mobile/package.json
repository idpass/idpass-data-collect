{
  "name": "@idpass/data-collect-mobile",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite  --port 8081 --host",
    "dev:web": "vite --config vite.config.web.ts --port 8081 --host",
    "build": "vue-tsc && vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "build:web:e2e": "VITE_DEVELOP=true vite build --config vite.config.web.ts --mode development",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.ts --port 8081 --host",
    "build:ios": "pnpm run build && cap sync ios && cap open ios",
    "build:android": "pnpm run build && cap sync android && cap open android",
    "build:android:apk": "./scripts/build-apk.sh debug",
    "build:android:apk:release": "./scripts/build-apk.sh release",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "postinstall": "patch-package",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^6.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@formio/vue": "^5.0.0",
    "@idpass/data-collect-core": "workspace:*",
    "@mdi/font": "^7.4.47",
    "@xstate/vue": "^5.0.1",
    "axios": "1.18.1",
    "bootstrap": "^5.3.8",
    "claim169": "0.3.0",
    "flatpickr": "^4.6.13",
    "flatpickr-formio": "4.6.13-formio.2",
    "font-awesome": "^4.7.0",
    "formiojs": "^4.21.7",
    "libsodium-wrappers": "^0.8.4",
    "lodash": "^4.18.1",
    "pinia": "^3.0.4",
    "rxdb": "^15.39.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9",
    "vue-router": "^5.2.0",
    "vuetify": "^3.11.8",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/lodash": "^4.17.25",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  },
  "homepage": "http://localhost:8081"
}
