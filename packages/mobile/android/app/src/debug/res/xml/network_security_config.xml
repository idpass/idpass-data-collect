<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config.
  Allows cleartext HTTP to localhost and the Android emulator host (10.0.2.2)
  so developers can connect to a local backend without TLS.
  This file is NOT included in release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Demo: temporary HTTP for Coolify demo-dci instances on genete.acn.fr.
             Remove after Friday 2026-05-15. Debug builds only — release stays strict. -->
        <domain includeSubdomains="true">genete.acn.fr</domain>
    </domain-config>
</network-security-config>
