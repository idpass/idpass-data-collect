<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config.
  Permits cleartext HTTP to ANY host so developers and QA can connect to a
  local/LAN backend by IP (e.g. http://192.168.x.x:3000) without TLS set up.
  Release builds use main/res/xml/network_security_config.xml, which keeps
  cleartextTrafficPermitted="false" (HTTPS required). This file is NOT bundled
  into release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
