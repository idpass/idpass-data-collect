{
  "name": "@idpass/data-collect-web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@idpass/data-collect-core": "workspace:*",
    "@formio/vue": "^5.0.0",
    "axios": "1.18.1",
    "bootstrap": "4.6.2",
    "formiojs": "^4.21.7",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^3.0.4",
    "uuid": "^14.0.2",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.11"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "~10.10.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
