    "test:unit": "vitest --run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@idpass/data-collect-core": "workspace:*",
    "@formio/vue": "^5.0.0",
    "axios": "^1.13.5",
    "bootstrap": "4.6.2",
    "formiojs": "^4.21.7",
    "oidc-client-ts": "^3.0.0",
    "pinia": "^3.0.4",
    "uuid": "^10.0.0",
    "vue": "^3.5.28",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.4",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.0.1",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^7.7.9",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
