    "vue-router": "^5.1.0",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^21.1.7",
