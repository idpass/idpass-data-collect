{
  "name": "@idpass/data-collect-core",
  "version": "2.0.0",
  "description": "Library to support offline data capture for a beneficiary management system",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "browser": "./dist/esm/browser.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/esm/browser.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./types": {
      "browser": "./dist/types/browser.d.ts",
      "default": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json",
    "./drizzle/*": "./drizzle/*"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "test": "jest --silent",
    "clean": "rimraf dist/",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:cjs && pnpm run build:esm",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist/types",
    "build:cjs": "tsc --project tsconfig.json --module commonjs --outDir dist/cjs",
    "build:esm": "tsc --project tsconfig.json --module esnext --outDir dist/esm",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "npx http-server ../../docs/api/datacollect -p 8080 -o",
    "format": "prettier --write .",
    "lint": "eslint . --config eslint.config.mjs --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lodash": "^4.18.1",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "uuid": "^14.0.1",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "axios-mock-adapter": "^2.1.0",
    "core-js": "^3.49.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idpass/idpass-data-collect.git"
  },
  "keywords": [
    "household-data-management",
    "offline-data-sync",
    "data-management"
  ],
  "author": "IDPass",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/idpass/idpass-data-collect/issues"
  },
  "homepage": "https://github.com/idpass/idpass-data-collect/blob/main/README.md",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
