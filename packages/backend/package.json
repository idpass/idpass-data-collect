{
  "name": "@idpass/data-collect-backend",
  "version": "2.1.0",
  "description": "Library to support offline data capture for a beneficiary management system",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "jest --silent",
    "test:e2e": "jest --silent --testPathPatterns=e2e",
    "dev": "nodemon",
    "clean": "rimraf dist/",
    "copy-files": "copyfiles -u 1 src/public/**/* dist && copyfiles openapi.yaml dist/",
    "build": "pnpm run clean && tsc --project tsconfig.json && pnpm run copy-files",
    "format": "prettier --write .",
    "api-docs": "echo 'OpenAPI spec available at http://localhost:3000/api-docs/openapi.json'",
    "validate-api": "redocly lint openapi.yaml --skip-rule=operation-4xx-response --skip-rule=no-server-example.com --skip-rule=operation-operationId --skip-rule=no-identical-paths --skip-rule=no-ambiguous-paths",
    "lint": "eslint . --config eslint.config.mjs --fix",
    "type-check": "tsc --noEmit -p tsconfig.type-check.json",
    "rebuild-projections": "ts-node src/cli/rebuild-projections.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@idpass/adapter-mock": "workspace:*",
    "@idpass/adapter-openspp": "workspace:*",
    "@idpass/adapter-openfn": "workspace:*",
    "@idpass/data-collect-core": "workspace:*",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^2.47.0",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/yamljs": "^0.2.34",
    "axios": "1.18.1",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sucrase": "^3.35.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idpass/idpass-data-collect.git"
  },
  "keywords": [
    "household-data-management",
    "offline-data-sync",
    "data-management"
  ],
  "author": "IDPass",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/idpass/idpass-data-collect/issues"
  },
  "homepage": "https://github.com/idpass/idpass-data-collect/blob/main/README.md",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
