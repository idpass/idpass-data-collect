# Sync Server environment for HOST development (running the backend outside Docker).
# Copy this file to packages/backend/.env:
#
#   cp packages/backend/.env.example packages/backend/.env
#
# The backend loads `.env` from its own working directory (`packages/backend`) via
# `dotenv/config`. `docker/.env` is read only by Docker Compose, which injects those
# variables into the container — nothing loads it when you run the backend on the host.
#
# Values here are LITERAL on purpose. `docker/.env` composes its connection strings
# from other variables ($POSTGRES_USER etc.); Compose expands those, plain dotenv does
# not, so copying that file to this location yields an unusable connection string.

# ---------------------------------
# PostgreSQL
# ---------------------------------
# Fully expanded, and the password is percent-encoded because it contains spaces and
# `!` (`Correct horse battery staple 42!` -> `Correct%20horse%20battery%20staple%2042%21`).
# Host development points at localhost; inside Docker the host would be `postgres`.
POSTGRES=postgresql://admin:Correct%20horse%20battery%20staple%2042%21@localhost:5432/datacollect
POSTGRES_TEST=postgresql://admin:Correct%20horse%20battery%20staple%2042%21@localhost:5432/datacollect_test

# -----------------------------
# Authentication
# -----------------------------
# ADMIN_PASSWORD must be ≥8 chars and include uppercase, lowercase, digit, and special char.
# JWT_SECRET must be ≥32 characters long — the server refuses to start otherwise.
ADMIN_EMAIL=admin@datacollect.lan
ADMIN_PASSWORD='Correct horse battery staple 42!'
JWT_SECRET='change-me-to-a-long-random-secret-at-least-32-chars'

# -------------------------
# Server
# -------------------------
SYNC_SERVER_PORT=3000
NODE_ENV=development

# -------------------------
# CORS
# -------------------------
# Comma-separated list of allowed origins for the Admin UI, Web App, and mobile preview.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# -------------------------
# Self-service (optional)
# -------------------------
# Returns the generated OTP in the API response as `devCode`. Local development only —
# must be unset in any deployed environment.
# OTP_EXPOSE_DEV_CODE=true
