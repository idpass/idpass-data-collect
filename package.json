{
  "name": "@idpass/data-collect",
  "version": "2.1.0",
  "description": "ID PASS DataCollect - Offline-first data management system",
  "private": true,
  "packageManager": "pnpm@10.14.0+sha256.297534e65d5842450539c1e8022c8831ab5e1fe2eb74664787a815519542d620",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "reinstall": "pnpm run clean && pnpm -r install",
    "clean": "pnpm -r --if-present run clean && rm -rf **/*/node_modules",
    "test": "pnpm -r --if-present run test",
    "test:all": "./scripts/test.sh",
    "test:datacollect": "pnpm --filter @idpass/data-collect-core test",
    "test:backend": "pnpm --filter @idpass/data-collect-backend test",
    "test:e2e:backend": "pnpm --filter @idpass/data-collect-backend test:e2e",
    "test:admin": "pnpm --filter @idpass/data-collect-admin test:unit",
    "test:e2e:admin": "pnpm --filter @idpass/data-collect-admin test:e2e",
    "test:adapter-openspp": "pnpm --filter @idpass/adapter-openspp test",
    "test:adapter-openfn": "pnpm --filter @idpass/adapter-openfn test",
    "build": "pnpm -r --if-present run build",
    "build:datacollect": "pnpm --filter @idpass/data-collect-core build",
    "build:backend": "pnpm --filter @idpass/data-collect-backend build",
    "build:admin": "pnpm --filter @idpass/data-collect-admin build",
    "build:docs": "pnpm --filter @idpass/data-collect-docs build",
    "dev:admin": "pnpm --filter @idpass/data-collect-admin dev",
    "dev:backend": "pnpm --filter @idpass/data-collect-backend dev",
    "dev:mobile": "pnpm --filter @idpass/data-collect-mobile dev",
    "dev:web": "pnpm --filter @idpass/data-collect-web dev",
    "build:web": "pnpm --filter @idpass/data-collect-web build",
    "test:web": "pnpm --filter @idpass/data-collect-web test:unit",
    "dev:docs": "pnpm --filter @idpass/data-collect-docs dev",
    "check-licenses": "node scripts/check-license-headers.js",
    "check-licenses:fix": "node scripts/check-license-headers.js --fix",
    "seed": "bash scripts/seed.sh",
    "lint": "pnpm -r --if-present run lint",
    "type-check": "pnpm -r --if-present run type-check",
    "ci:install": "pnpm install",
    "prepare": "[ \"$CI\" != \"true\" ] && husky install || echo 'Skipping husky in CI'",
    "pr-check": "./scripts/pr-check.sh",
    "test:e2e:mobile": "pnpm --filter @idpass/data-collect-mobile test:e2e",
    "test:e2e:integration": "pnpm --filter @idpass/data-collect-admin exec playwright test --config ../../e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "^8.0.3",
    "lint-staged": "^17.4.1",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js,jsx}": [
      "node scripts/check-license-headers-staged.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idpass/idpass-data-collect.git"
  },
  "keywords": [
    "offline-first",
    "data-management",
    "event-sourcing",
    "synchronization"
  ],
  "author": "Association pour la Coopération Numérique",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/idpass/idpass-data-collect/issues"
  },
  "homepage": "https://github.com/idpass/idpass-data-collect#readme",
  "pnpm": {
    "overrides": {
      "lodash-es@<=4.17.22": ">=4.17.23",
      "lodash@<=4.17.22": ">=4.17.23",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "@babel/runtime@<7.26.10": ">=7.26.10 <8",
      "webpack-dev-server@<=5.2.0": ">=5.2.1",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "ajv@>=8.0.0 <8.18.0": ">=8.18.0",
      "tar@>=7.0.0 <7.5.19": ">=7.5.19 <8",
      "websocket-driver@<0.7.5": ">=0.7.5 <0.8",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11 <8",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9",
      "nanoid@>=3.0.0 <3.3.18": ">=3.3.18 <4",
      "nanoid@>=5.0.0 <5.1.16": ">=5.1.16 <6",
      "postcss@>=8.0.0 <8.5.18": ">=8.5.18 <9",
      "brace-expansion@>=1.0.0 <1.1.16": ">=1.1.16 <2",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9 <6",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4",
      "immutable@>=4.0.0 <4.3.9": ">=4.3.9 <5",
      "immutable@>=5.0.0 <5.1.8": ">=5.1.8 <6",
      "svgo@>=3.0.0 <3.3.4": ">=3.3.4 <4"
    }
  }
}