# Copy to .env and adjust as needed.

# Network
MOCK_HOST=0.0.0.0
MOCK_PORT=9999

# Database
MOCK_DB_PATH=./mock_registry.db

# OAuth2 — default client bootstrap
#
# These are used to seed a default OAuth2 client row on first startup only.
# They are NOT the authentication source of truth: once seeded, credentials
# are verified against the `api_client` table (bcrypt-hashed secrets).
# Manage additional clients via /ui/clients or /v1/api-clients. Rotating a
# secret through the UI will NOT be overwritten by subsequent restarts.
MOCK_OAUTH_CLIENT_ID=mock-client
MOCK_OAUTH_CLIENT_SECRET=mock-secret

# JWT — set a stable value in non-dev environments so tokens survive restart
MOCK_JWT_SECRET=
MOCK_JWT_TTL_SECONDS=3600

# Session (UI)
MOCK_SESSION_SECRET=
MOCK_UI_USERNAME=admin
MOCK_UI_PASSWORD=admin

# Identifier scheme URI used for auto-assigned system_id values
MOCK_IDENTIFIER_SCHEME=urn:mock:vocab:id-type

MOCK_LOG_LEVEL=INFO
