# Sync Server Environment Configuration Example
# Copy this file to .env and update with your values

# ---------------------------------
# PostgreSQL Database Configuration
# ---------------------------------
# These values are used by both the Sync Server and the PostgreSQL container.
POSTGRES_USER=admin
POSTGRES_PASSWORD='Correct horse battery staple 42!'
POSTGRES_DB=datacollect
POSTGRES_HOST=postgres # Use the service name from docker-compose

# Connection string used by the Sync Server application
POSTGRES=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:5432/$POSTGRES_DB
POSTGRES_TEST=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:5432/${POSTGRES_DB}_test

# -----------------------------
# Authentication Configuration
# -----------------------------
# ADMIN_PASSWORD must be ≥8 chars and include uppercase, lowercase, digit, and special char.
# JWT_SECRET must be ≥32 characters long — the server refuses to start otherwise.
ADMIN_EMAIL=admin@datacollect.lan
ADMIN_PASSWORD='Correct horse battery staple 42!'
JWT_SECRET='change-me-to-a-long-random-secret-at-least-32-chars'

# -------------------------
# Server Configuration
# -------------------------
SYNC_SERVER_PORT=3000
NODE_ENV=development # Options: development, production
# Optional: explicitly set the public base URL used in QR codes and downloads
# PUBLIC_BASE_URL=http://localhost:3000

# -------------------------
# CORS Configuration
# -------------------------
# Comma-separated list of allowed origins for the Admin UI and Web App.
# Required in production. For local dev the defaults below match the dev compose.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# -------------------------
# pgAdmin Configuration
# -------------------------
PGADMIN_DEFAULT_EMAIL=admin@datacollect.lan
PGADMIN_DEFAULT_PASSWORD='Correct horse battery staple 42!'

# -------------------------
# OpenSPP Integration (optional)
# -------------------------
EXTERNAL_SYNC_ENABLED=false
OPENSPP_URL=http://openspp:8069
OPENSPP_DB=odoo
OPENSPP_USERNAME=admin
OPENSPP_PASSWORD=admin

# -------------------------
# Mobile App Configuration
# -------------------------
VITE_DB_ENCRYPTION_PASSWORD=changeme
