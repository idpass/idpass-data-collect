# Stage 1: Build the portal SPA
FROM node:22-bookworm-slim AS build
RUN npm i -g pnpm
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @idpass/data-collect-portal run build

# Stage 2: Serve with nginx
FROM nginx:1.27-alpine AS serve
COPY --from=build /app/packages/portal/dist /usr/share/nginx/html
COPY docker/portal-nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
# envsubst replaces $KEYCLOAK_ORIGIN in the nginx config template at startup
CMD ["nginx", "-g", "daemon off;"]
