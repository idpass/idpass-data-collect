FROM node:22-bookworm-slim AS base
RUN npm i -g pnpm

FROM base AS build
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm run build:datacollect
RUN pnpm --filter @idpass/adapter-openspp --filter @idpass/adapter-openfn --filter @idpass/adapter-mock build
RUN pnpm run build:backend

FROM base AS backend
WORKDIR /app
# Own the app tree as the unprivileged built-in node user so the dev server can
# write generated files at runtime while running as non-root.
COPY --from=build --chown=node:node /app .
# COPY --chown only owns the copied entries, not the WORKDIR-created /app itself.
# pnpm writes a scratch file into the cwd on every `pnpm run`, so /app must be
# writable by node or the dev server crash-loops on EACCES.
RUN chown node:node /app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"
USER node
CMD ["pnpm", "run", "dev:backend"]

FROM base AS admin-ui
WORKDIR /app
COPY --from=build /app .
EXPOSE 5173
CMD ["pnpm", "run", "dev:admin"]

FROM base AS mobile-app
WORKDIR /app
COPY --from=build /app .
EXPOSE 8081
CMD ["pnpm", "run", "dev:mobile"]

FROM base AS web-ui
WORKDIR /app
COPY --from=build /app .
EXPOSE 5174
CMD ["pnpm", "run", "dev:web"]
